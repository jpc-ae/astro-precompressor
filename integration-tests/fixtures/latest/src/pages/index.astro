---
const title = 'Astro Precompressor integration test'
const content = 'This page is deliberately larger than the minimum compression threshold. '.repeat(20)
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<h1>{title}</h1>
			<p>{content}</p>
		</main>
	</body>
</html>
